-- A pattern that is wrong is an error that says where and why
::dependency nanyx.regex ./nanyx.regex

import nanyx.regex/regex

def re = { pattern ->
  match Regex.parse(pattern)
    | #some(r) -> r
    | #invalidPattern(e) -> crash("{pattern}: {e.message}")
}

def show = { pattern, text ->
  match text \Regex.find(re(pattern))
    | #some(m) -> println("{m.text} {m.start}-{m.end}")
    | #notFound -> println("none")
}

def bad = { pattern ->
  match Regex.parse(pattern)
    | #some(_) -> println("ok")
    | #invalidPattern(e) -> println("{e.column}: {e.message}")
}

bad('(a')
bad('a)')
bad('[a')
bad('[z-a]')
bad('[\d-z]')
bad('*a')
bad('a**')
bad('a{1001}')
bad('a{3,2}')
bad("a\\")
bad('\q')
bad('\x4')
bad('[\b]')
bad('(?x)')
bad('[[:nope:]]')
bad('(?<>a)')
bad('(?<year>\d+)(?<year>x)')
